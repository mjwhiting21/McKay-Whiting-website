{
  "manifest_version": 3,
  "name": "No Feed",
  "version": "1.0.0",
  "description": "Hides the home feed on social sites. Posting, search, messages, analytics and Marketplace keep working.",
  "permissions": ["storage"],
  "action": {
    "default_title": "No Feed",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["sites.js", "content.js"],
      "css": ["hide.css"],
      "run_at": "document_start"
    }
  ]
}
